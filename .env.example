# Server-only configuration. Never add these values to VITE_* variables.
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://luma:change-me@localhost:5432/luma
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-random-64-character-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ALLOWED_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
TRUST_PROXY=false
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=30
DAILY_TOKEN_QUOTA=100000
RETENTION_DAYS=90
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o
AI_FAST_MODEL=gpt-4o-mini
AI_DEEP_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=
MAX_CONTEXT_TOKENS=12000
DATA_DIR=.data